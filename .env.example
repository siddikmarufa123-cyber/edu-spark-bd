# এই ফাইলটির নাম বদলে .env.local রেখে নিজের মান বসান (শুধু লোকাল টেস্টের জন্য)।
# Supabase → Project Settings → API থেকে নিন।
# anon key সবার জন্য উন্মুক্ত (public) কী — নিরাপত্তা Row Level Security দিয়ে হয়।
# কখনোই service_role key এখানে বা GitHub-এ দেবেন না।
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
